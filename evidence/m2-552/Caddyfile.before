40-75-139-128.sslip.io {
	encode gzip
	handle /openapi.json {
		reverse_proxy webread:8000 payto:8000 api:8000 {
			lb_policy first
			lb_try_duration 5s
			fail_duration 30s
		}
	}
	handle /.well-known/x402 {
		root * /srv/x402
		header Content-Type application/json
		file_server
	}
	handle /llms.txt {
		root * /srv/x402
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle /x402/* {
		root * /srv/x402
		file_server
	}
	handle /v1/payto-activity/* {
		reverse_proxy payto:8000
	}
	handle /gas {
		reverse_proxy gas:8000
	}
	handle /gas/* {
		reverse_proxy gas:8000
	}
	handle /v1/web-read/* {
		reverse_proxy webread:8000
	}
	handle /1e6eea703c1228b6ce47bfb111e92b1a.txt {
		root * /srv/x402
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	@siteverify path_regexp siteverify ^/(google[0-9a-f]+\.html|BingSiteAuth\.xml)$
	handle @siteverify {
		root * /srv/x402/verify
		file_server
	}
	handle /robots.txt {
		root * /srv/x402
		file_server
	}
	handle /hosting {
		redir * /hosting/ 301
	}
	handle /hosting/* {
		root * /srv/x402
		file_server
	}
	handle /go/hostinger {
		header X-Robots-Tag "noindex, nofollow"
		redir https://www.hostinger.com/vps-hosting 302
	}
	handle /go/vultr {
		header X-Robots-Tag "noindex, nofollow"
		redir https://www.vultr.com/pricing/ 302
	}
	handle /wordpress {
		redir * /wordpress/ 301
	}
	handle /wordpress/* {
		root * /srv/x402
		file_server
	}
	handle /page-builders {
		redir * /page-builders/ 301
	}
	handle /page-builders/* {
		root * /srv/x402
		file_server
	}
	handle /go/elementor {
		redir https://elementor.com/pricing/ 302
	}
	handle /go/divi {
