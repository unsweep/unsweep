	}
	handle /go/thrive {
		redir https://thrivethemes.com/architect/ 302
	}
	handle /go/brizy {
		redir https://brizy.io/pricing/ 302
	}
	handle /tts {
		redir * /tts/ 301
	}
	handle /tts/* {
		root * /srv/x402
		file_server
	}
	handle /go/elevenlabs {
		header X-Robots-Tag "noindex, nofollow"
		redir https://elevenlabs.io/ 302
	}
	handle /go/fishaudio {
		header X-Robots-Tag "noindex, nofollow"
		redir https://fish.audio/ 302
	}
	handle /go/polly {
		header X-Robots-Tag "noindex, nofollow"
		redir https://aws.amazon.com/polly/ 302
	}
	handle /go/gcloudtts {
		header X-Robots-Tag "noindex, nofollow"
		redir https://cloud.google.com/text-to-speech 302
	}
	handle /go/speechify {
		header X-Robots-Tag "noindex, nofollow"
		redir https://speechify.com/ 302
